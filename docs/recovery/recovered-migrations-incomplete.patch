+CREATE FUNCTION public.post_financial_opening_cash(p_command jsonb)
+RETURNS jsonb LANGUAGE plpgsql SECURITY DEFINER SET search_path = '' AS $$
+BEGIN
+  RETURN financial_core.post_f3_opening_cash(p_command);
+END;
+$$;
